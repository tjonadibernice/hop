# Postgres (used by Docker Compose to create the database)
POSTGRES_USER=hop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hop

# Connection URLs (must match the values above)
DATABASE_URL=postgresql+asyncpg://hop:change-me@localhost:5432/hop
TEST_DATABASE_URL=postgresql+asyncpg://hop:change-me@localhost:5432/hop_test
REDIS_URL=redis://localhost:6379/0

# Email (defaults work with Mailpit from docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Hop <no-reply@hop.local>
APP_BASE_URL=http://localhost:5173