# Postgres (used by Docker Compose to create the database)
POSTGRES_USER=hop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hop

# Connection URLs (must match the values above)
DATABASE_URL=postgresql+asyncpg://hop:change-me@localhost:5432/hop
TEST_DATABASE_URL=postgresql+asyncpg://hop:change-me@localhost:5432/hop_test
REDIS_URL=redis://localhost:6379/0

# Email (defaults work with Mailpit from docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Hop <no-reply@hop.local>
APP_BASE_URL=http://localhost:5173

# Sessions (set COOKIE_SECURE=true in production, where the site uses HTTPS)
COOKIE_SECURE=false
# Ingestion crawler (optional; these are the defaults)
CRAWL_DELAY_SECONDS=1.0
# Never true outside local testing: lets the crawler reach private addresses
CRAWL_ALLOW_PRIVATE_HOSTS=false

# Enrichment (all optional, all have free tiers; never commit real keys)
# LLM providers, tried in this order: set at least one
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional pacing and budget limits per provider (empty = default)
# GEMINI_REQUESTS_PER_MINUTE=10
# GEMINI_MAX_CALLS_PER_DAY=1000
# OPENAI_REQUESTS_PER_MINUTE=
# OPENAI_MAX_CALLS_PER_DAY=1000
# Local model through Ollama, e.g. http://localhost:11434/v1 (needs no key)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
# Embeddings (without a key, pages are stored without one)
VOYAGE_API_KEY=
# Google Safe Browsing (without a key, pages can't be auto-approved)
SAFE_BROWSING_API_KEY=

# Who may use the review screen and remove pages (comma-separated emails)
ADMIN_EMAILS=

# Rate limits on sign-up, login, and email confirmation (keep true)
RATE_LIMIT_ENABLED=true
